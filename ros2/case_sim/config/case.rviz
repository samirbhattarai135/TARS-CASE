Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /RobotModel1
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Class: ""
  Name: root
  Global Options:
    Background Color: 48; 48; 48
    # base_link, not odom: nothing in this system publishes odometry, and a
    # Fixed Frame with no transform makes RViz refuse to draw anything at all.
    # robot_state_publisher always provides base_link, so this always resolves.
    # Switch the dropdown to the world frame (see the pose bridge in the launch
    # file) to watch the chassis tilt instead of spinning in place.
    # case_world is the ground-truth world frame from the pose bridge, joined
    # to base_link by the static transform in the launch file. This is the frame
    # that shows the chassis tilting; base_link would show it standing still
    # forever, which for a balancer hides the only interesting motion.
    Fixed Frame: case_world
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 20
      Color: 160; 160; 164
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Alpha: 1
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Axes: true
      Show Names: false
      Marker Scale: 0.15
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      # Close in and slightly above the axle: pitch is the quantity of interest
      # and it reads best from near the robot's own height.
      Distance: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0.06
      Pitch: 0.25
      Yaw: 2.2
      Target Frame: base_link

Window Geometry:
  Height: 800
  Width: 1200
  Displays:
    collapsed: false
